<Window x:Class="SapiManager.Views.AddProviderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Speech Provider Package" Height="600" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F3F3"
        AutomationProperties.Name="Add Speech Provider Package"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="Add Speech Provider Package" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Focusable="True" KeyboardNavigation.TabIndex="0" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock Text="Select a ZIP package containing a TTS provider to inspect and install." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- File Picker -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtZipPath" Grid.Column="0" Height="36" Padding="8,8" VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" IsReadOnly="True" AutomationProperties.Name="Zip Package Path" Margin="0,0,8,0"/>
            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Height="36" Width="90" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Click="BtnBrowse_Click" AutomationProperties.Name="Browse"/>
        </Grid>

        <!-- Package Info Panel -->
        <Border x:Name="PnlDetails" Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16" IsEnabled="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Foreground="#475569" Margin="0,4"/>
                <TextBlock x:Name="TxtPkgName" Grid.Row="0" Grid.Column="1" Text="-" Foreground="#0F172A" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version:" FontWeight="SemiBold" Foreground="#475569" Margin="0,4"/>
                <TextBlock x:Name="TxtPkgVersion" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#0F172A" Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Publisher:" FontWeight="SemiBold" Foreground="#475569" Margin="0,4"/>
                <TextBlock x:Name="TxtPkgPublisher" Grid.Row="2" Grid.Column="1" Text="-" Foreground="#0F172A" Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Executable:" FontWeight="SemiBold" Foreground="#475569" Margin="0,4"/>
                <TextBlock x:Name="TxtPkgExe" Grid.Row="3" Grid.Column="1" Text="-" Foreground="#0F172A" Margin="0,4"/>
            </Grid>
        </Border>

        <!-- Process Lock Warning Banner -->
        <Border x:Name="BdrProcessLock" Grid.Row="3" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtLockStatus" Grid.Column="0" TextWrapping="Wrap" Foreground="#991B1B" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="BtnTerminateProcess" Grid.Column="1" Content="Close Running Process" Padding="12,6" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="BtnTerminateProcess_Click" AutomationProperties.Name="Close Running Process"/>
            </Grid>
        </Border>

        <!-- Status Text -->
        <TextBlock x:Name="TxtStatus" Grid.Row="4" Text="" FontSize="12" Foreground="#2563EB" TextWrapping="Wrap" Margin="0,0,0,16" VerticalAlignment="Top" AutomationProperties.Name="Status"/>

        <!-- Action Controls -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="36" Margin="0,0,8,0" Click="BtnCancel_Click" AutomationProperties.Name="Cancel"/>
            <Button x:Name="BtnInstall" Content="Install Provider" Width="140" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="BtnInstall_Click" AutomationProperties.Name="Install Provider"/>
        </StackPanel>
    </Grid>
</Window>
