<Window x:Class="SapiManager.Views.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModernSapiAdapter Setup" Height="380" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtTitle" Text="ModernSapiAdapter Setup" FontSize="22" FontWeight="Bold" Foreground="#111827" AutomationProperties.Name="Setup Title"/>
            <TextBlock x:Name="TxtSubtitle" Text="SAPI 5 Speech Adapter Management Ecosystem" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Body / Description -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,16,0,16" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Installation Details">
                <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" FontSize="14" Foreground="#374151" LineHeight="20">
                    This wizard will install ModernSapiAdapter and its Core COM Engine to C:\Program Files\ModernSapiAdapter.
                </TextBlock>
            </ScrollViewer>
        </Border>

        <!-- Status Message -->
        <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,12" TextWrapping="Wrap" AutomationProperties.Name="Installation Status"/>

        <!-- Action Button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="34" Margin="0,0,12,0" Click="BtnCancel_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" AutomationProperties.Name="Cancel" AutomationProperties.HelpText="Exits setup without modifying your system."/>
            <Button x:Name="BtnAction" Content="Install" Width="130" Height="34" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="BtnAction_Click" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
    </Grid>
</Window>
