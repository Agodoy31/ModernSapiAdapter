<Window x:Class="SapiManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModernSapiAdapter - Speech Provider Manager" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F8FAFC">
    <Grid>
        <TabControl x:Name="MainTabControl" Background="White" BorderThickness="0">
            <!-- Tab 1: Provider Management -->
            <TabItem Header="Provider Management" AutomationProperties.Name="Provider Management">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar -->
                    <Border Grid.Column="0" Background="#1E293B" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                                <TextBlock Text="ModernSapiAdapter" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Speech Provider Manager" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Button x:Name="BtnAddProvider" Content="Add Provider..." Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,0,8" Click="BtnAddProvider_Click" AutomationProperties.Name="Add Provider" AutomationProperties.HelpText="Browse for an external Provider executable file to add."/>
                                <Button x:Name="BtnRefresh" Content="Refresh Providers" Height="36" Background="#334155" Foreground="White" FontWeight="SemiBold" Click="BtnRefresh_Click" AutomationProperties.Name="Refresh Providers" AutomationProperties.HelpText="Scans for added or updated speech providers."/>
                            </StackPanel>

                            <ListBox x:Name="LstProviders" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="LstProviders_SelectionChanged" Margin="0,0,0,12" AutomationProperties.Name="Discovered Providers List" AutomationProperties.HelpText="Select a speech provider to configure its voices and settings.">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding ProviderName}"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2">
                                            <TextBlock Text="{Binding ProviderName}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Right Pane (Provider Details Panel) -->
                    <Border Grid.Column="1" Padding="24" Background="#F8FAFC">
                        <Grid x:Name="PnlProviderDetails" IsEnabled="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Provider Details Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                                <Button x:Name="BtnConfigure" DockPanel.Dock="Right" Content="Configure Provider" Height="36" Padding="16,0" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Click="BtnConfigure_Click" AutomationProperties.Name="Configure Provider" AutomationProperties.HelpText="Launches the configuration UI for the selected provider executable."/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedProvider" Text="Select a Provider" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="TxtProviderDetails" Text="Select a provider from the sidebar to manage voices and settings." FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Voices List Panel -->
                            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBlock Text="Available Voices" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="Check voices to register them as SAPI 5 system tokens." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <ListBox x:Name="LstVoices" BorderThickness="0" Background="Transparent" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" KeyDown="LstVoices_KeyDown">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding FullAccessibilityLabel}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="4"/>
                                                <Setter Property="Margin" Value="0,2"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsRegistered, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" Focusable="False" AutomationProperties.Name="{Binding Name}"/>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Language, StringFormat='Language: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,16,0"/>
                                                                <TextBlock Text="{Binding Gender, StringFormat='Gender: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,16,0"/>
                                                                <TextBlock Text="{Binding Vendor, StringFormat='Vendor: {0}'}" FontSize="11" Foreground="#64748B"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Bottom Save Action Bar -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button x:Name="BtnSaveVoices" Content="Save Voices" Width="160" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="BtnSaveVoices_Click" AutomationProperties.Name="Save Voices" AutomationProperties.HelpText="Applies voice registration changes to the SAPI 5 system registry."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: SAPI 5 Tester (Reserved Container for Task 5) -->
            <TabItem Header="SAPI 5 Tester" AutomationProperties.Name="SAPI 5 Tester">
                <Border Padding="24" Background="#F8FAFC">
                    <Grid x:Name="PnlSapiTesterContainer">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SAPI 5 Speech Tester" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Query and test installed SAPI 5 voices with custom text, speech parameters, and event telemetry." FontSize="13" Foreground="#64748B" Margin="0,2,0,16"/>

                            <!-- Voice Selection Section -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Select SAPI 5 Voice" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbTestVoice" Height="32" VerticalContentAlignment="Center" SelectionChanged="CmbTestVoice_SelectionChanged" AutomationProperties.Name="Select SAPI 5 Voice" AutomationProperties.HelpText="Selects the target SAPI 5 voice for speech synthesis."/>
                                </StackPanel>
                            </Grid>

                            <!-- Speech Parameters Sliders -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Rate Slider -->
                                <StackPanel Grid.Column="0">
                                    <DockPanel>
                                        <TextBlock Text="Rate:" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                        <TextBlock x:Name="TxtRateVal" Text="0" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                                    </DockPanel>
                                    <Slider x:Name="SldRate" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="SldRate_ValueChanged" AutomationProperties.Name="Speech Rate" AutomationProperties.HelpText="Adjusts speech synthesis rate from minus 10 to plus 10."/>
                                </StackPanel>

                                <!-- Volume Slider -->
                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock Text="Volume:" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                        <TextBlock x:Name="TxtVolumeVal" Text="100" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                                    </DockPanel>
                                    <Slider x:Name="SldVolume" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="SldVolume_ValueChanged" AutomationProperties.Name="Speech Volume" AutomationProperties.HelpText="Adjusts speech volume from 0 to 100."/>
                                </StackPanel>

                                <!-- Pitch Slider -->
                                <StackPanel Grid.Column="4">
                                    <DockPanel>
                                        <TextBlock Text="Pitch:" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                        <TextBlock x:Name="TxtPitchVal" Text="0" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                                    </DockPanel>
                                    <Slider x:Name="SldPitch" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="SldPitch_ValueChanged" AutomationProperties.Name="Speech Pitch" AutomationProperties.HelpText="Adjusts speech pitch from minus 10 to plus 10."/>
                                </StackPanel>
                            </Grid>

                            <!-- Input Text & Preset Controls -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Test Text Input" FontWeight="SemiBold" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox x:Name="ChkIsSsml" Content="Interpret SSML/XML" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.Name="Interpret SSML XML" AutomationProperties.HelpText="Toggles between plain text and SSML XML synthesis mode."/>
                                    <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbSampleText" Width="170" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbSampleText_SelectionChanged" AutomationProperties.Name="Sample Text Presets" AutomationProperties.HelpText="Selects sample text presets."/>
                                </StackPanel>
                            </DockPanel>

                            <TextBox x:Name="TxtTestInput" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" Text="Hello! This is a SAPI 5 voice synthesis test using ModernSapiAdapter." Margin="0,0,0,16" AutomationProperties.Name="Test Text Input" AutomationProperties.HelpText="Type or paste text to synthesize using the selected SAPI 5 voice."/>

                            <!-- Playback Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnTestPlay" Content="Speak" Width="100" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" Click="BtnTestPlay_Click" AutomationProperties.Name="Speak" AutomationProperties.HelpText="Starts or resumes speech synthesis."/>
                                <Button x:Name="BtnTestPause" Visibility="Collapsed" Content="Pause" Width="90" Height="36" Background="#475569" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Click="BtnTestPause_Click" AutomationProperties.Name="Pause" AutomationProperties.HelpText="Pauses active speech synthesis."/>
                                <Button x:Name="BtnTestStop" Visibility="Collapsed" Content="Stop" Width="90" Height="36" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Click="BtnTestStop_Click" AutomationProperties.Name="Stop" AutomationProperties.HelpText="Stops active speech synthesis and clears playback queue."/>
                            </StackPanel>

                            <!-- Live Telemetry / Event Log -->
                            <TextBlock Text="Event Telemetry Log" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtTestLog" Height="110" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#F1F5F9" Foreground="#1E293B" FontFamily="Consolas" FontSize="11" Padding="8" AutomationProperties.Name="Event Telemetry Log" AutomationProperties.HelpText="Displays real-time SAPI 5 synthesis events, word progress, and bookmark callbacks."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </TabItem>
        </TabControl>
        <!-- Modal Overlay to dim the background when a dialog is open -->
        <Border x:Name="ModalOverlay" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="999"/>
    </Grid>
</Window>
