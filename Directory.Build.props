<Project>
  <!-- Global Build Output & Intermediate Directories -->
  <PropertyGroup>
    <!-- Centralized binary output directory -->
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\</OutDir>
    
    <!-- Centralized intermediate build directory per project -->
    <IntDir>$(MSBuildThisFileDirectory)build\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>

    <!-- .NET / C# project equivalents for future provider projects -->
    <OutputPath>$(OutDir)</OutputPath>
    <IntermediateOutputPath>$(IntDir)</IntermediateOutputPath>
  </PropertyGroup>
</Project>
